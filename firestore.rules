rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidScrapFields(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.url is string && data.url.size() > 0 && data.url.size() <= 2048
        && data.url.matches('^https?://.*')
        && (!('title' in data) || (data.title is string && data.title.size() <= 500))
        && (!('originalTitle' in data) || (data.originalTitle is string && data.originalTitle.size() <= 500))
        && (!('thumbnail' in data) || data.thumbnail == null || (data.thumbnail is string && data.thumbnail.size() <= 2048))
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 10))
        && (!('fullSummary' in data) || (data.fullSummary is string && data.fullSummary.size() <= 15000))
        && (!('contentType' in data) || (data.contentType is string && data.contentType in ['general', 'recipe', 'tech', 'video', 'place', 'product']))
        && (!('isPinned' in data) || data.isPinned is bool)
        && (!('isRead' in data) || data.isRead is bool)
        && (!('userNote' in data) || (data.userNote is string && data.userNote.size() <= 5000))
        && (!('checkedItems' in data) || (data.checkedItems is list && data.checkedItems.size() <= 100))
        && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    match /scraps/{scrapId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'url', 'title', 'originalTitle', 'thumbnail', 'tags', 'fullSummary',
          'contentType', 'isPinned', 'isRead', 'userNote', 'checkedItems', 'createdAt'
        ])
        && isValidScrapFields(request.resource.data);
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'originalTitle', 'thumbnail', 'tags', 'fullSummary',
          'contentType', 'isPinned', 'isRead', 'userNote', 'checkedItems'
        ])
        && isValidScrapFields(request.resource.data);
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['language', 'useAi'])
        && (!('language' in request.resource.data) || request.resource.data.language in ['en', 'ja', 'ko', 'zh'])
        && (!('useAi' in request.resource.data) || request.resource.data.useAi is bool);
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['language', 'useAi'])
        && (!('language' in request.resource.data) || request.resource.data.language in ['en', 'ja', 'ko', 'zh'])
        && (!('useAi' in request.resource.data) || request.resource.data.useAi is bool);
    }
  }
}
